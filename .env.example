# Replace every placeholder before the first docker compose up.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
SOURCE_DB_PASSWORD=replace-source-password
RESTORE_DB_PASSWORD=replace-restore-password
BORG_PASSPHRASE=replace-and-save-this-encryption-passphrase
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
